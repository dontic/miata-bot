# Telegram: create a bot with @BotFather, then get your chat id by messaging the bot
# and opening https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Search to watch. Paste it straight from the browser; the #! form is fine.
SEARCH_URL=https://www.theparking.eu/#!/used-cars/mx5.html%3Fid_volant%3D1%26slider_millesime%3D1910%7C1997%26tri%3Ddate

# Countries to notify for: "EU" (EU-27), a comma list of ISO codes (e.g. "es,pt,fr,de"),
# or "*" for everywhere.
ALLOWED_COUNTRIES=EU

# Result pages to scan per run (~25 listings each, sorted newest first).
MAX_PAGES=1
INTERVAL_MINUTES=60

DB_PATH=data/listings.db
CHROME_PROFILE_DIR=data/chrome-profile
