# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
sdist/

# Virtual environments (uv creates .venv)
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checkers / linters
.mypy_cache/
.pyright/
.ruff_cache/
.pytype/
.dmypy.json

# Jupyter
.ipynb_checkpoints/

# Logs and local data
*.log
*.sqlite3
*.db

# Editors
# .vscode/settings.json is generated per-window by the unique-window-colors extension;
# shared editor settings live in .devcontainer/devcontainer.json
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json
